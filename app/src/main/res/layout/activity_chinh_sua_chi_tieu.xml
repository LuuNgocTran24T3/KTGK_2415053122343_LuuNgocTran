
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CHỈNH SỬA KHOẢN CHI"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="20dp" />

    <EditText
        android:id="@+id/edtSuaTenKhoanChi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tên khoản chi"
        android:inputType="textCapSentences" />

    <EditText
        android:id="@+id/edtSuaSoTien"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Số tiền"
        android:inputType="numberDecimal|numberSigned" />

    <EditText
        android:id="@+id/edtSuaGhiChu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ghi chú"
        android:inputType="textCapSentences"
        android:minLines="2"
        android:gravity="top" />

    <Button
        android:id="@+id/btnLuuChinhSua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lưu chỉnh sửa"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnHuyChinhSua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hủy" />

</LinearLayout>